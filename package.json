{
  "name": "grass-shader",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev -p 5207",
    "dev:phone": "vinext dev -H 0.0.0.0 -p 5207",
    "build": "vinext build",
    "start": "vinext start -p 5207",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app scripts tests vite.config.ts next.config.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "ios:sync": "npm run build && node scripts/sync-ios.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "dialkit": "^1.4.3",
    "motion": "^13.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.4.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.3.0",
    "vite": "8.3.5"
  },
  "type": "module",
  "description": "A real-time ornamental grass shader with reference footage and an offline iPhone app."
}
